AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
S3_BUCKET=

CAV_DB_HOST=localhost
CAV_DB_USER=
CAV_DB_PASS=
